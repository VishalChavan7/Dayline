<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+), drawn in your wallpaper colours. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/shape_flower" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center_horizontal">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_w_flame" android:tint="@color/preview_primary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12" android:textSize="32sp" android:textColor="@color/preview_on_container" android:maxLines="1" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2/4 today" android:textSize="11sp" android:textColor="@color/preview_on_container" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
