<?xml version="1.0" encoding="utf-8"?>
<!-- Focus widget countdown, 52dp digits, hours over minutes. Generated. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="30.7dp"
        android:layout_height="wrap_content">
        <Chronometer
            android:id="@+id/chrono_top"
            android:layout_width="249.6dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-0.0dp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:gravity="start"
            android:textColor="@color/widget_timer_text"
            android:textSize="52dp" />
    </FrameLayout>
    <FrameLayout
        android:layout_width="61.5dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-5.2dp">
        <Chronometer
            android:id="@+id/chrono_bottom"
            android:layout_width="249.6dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-62.4dp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:gravity="start"
            android:textColor="@color/widget_timer_text"
            android:textSize="52dp" />
    </FrameLayout>
</LinearLayout>
