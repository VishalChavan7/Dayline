<?xml version="1.0" encoding="utf-8"?>
<!-- Focus widget countdown, 78dp digits, hours over minutes. Generated. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="46.1dp"
        android:layout_height="wrap_content">
        <Chronometer
            android:id="@+id/chrono_top"
            android:layout_width="374.4dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-0.0dp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:gravity="start"
            android:textColor="@color/widget_timer_text"
            android:textSize="78dp" />
    </FrameLayout>
    <FrameLayout
        android:layout_width="92.2dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-7.8dp">
        <Chronometer
            android:id="@+id/chrono_bottom"
            android:layout_width="374.4dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-93.6dp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:gravity="start"
            android:textColor="@color/widget_timer_text"
            android:textSize="78dp" />
    </FrameLayout>
</LinearLayout>
