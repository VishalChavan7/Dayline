<?xml version="1.0" encoding="utf-8"?>
<!-- Focus widget countdown, 64dp digits, hours over minutes. Generated. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="37.8dp"
        android:layout_height="wrap_content">
        <Chronometer
            android:id="@+id/chrono_top"
            android:layout_width="307.2dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-0.0dp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:gravity="start"
            android:textColor="@color/widget_timer_text"
            android:textSize="64dp" />
    </FrameLayout>
    <FrameLayout
        android:layout_width="75.6dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-6.4dp">
        <Chronometer
            android:id="@+id/chrono_bottom"
            android:layout_width="307.2dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-76.8dp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:gravity="start"
            android:textColor="@color/widget_timer_text"
            android:textSize="64dp" />
    </FrameLayout>
</LinearLayout>
