<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+), drawn in your wallpaper colours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/preview_card" android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textSize="13sp" android:textColor="@color/preview_muted" android:maxLines="1" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60%" android:textSize="34sp" android:textColor="@color/preview_primary" android:maxLines="1" android:textStyle="bold" />
    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 of 5 done" android:textSize="12sp" android:textColor="@color/preview_on" android:maxLines="1" />
    <FrameLayout android:layout_width="1dp" android:layout_height="6dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="8dp" android:orientation="horizontal" android:background="@drawable/preview_pill_container">
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:background="@drawable/preview_box_primary" />
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" />
    </LinearLayout>
</LinearLayout>
